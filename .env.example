# Database
DATABASE_URL=sqlite+aiosqlite:////data/dek_kard.db

# Media storage
MEDIA_DIR=/data/media

# LLM - Anthropic (required)
ANTHROPIC_API_KEY=sk-ant-...

# LLM - OpenAI (optional, only needed if you switch a task to OpenAI)
OPENAI_API_KEY=sk-...

# Per-task model config (override defaults)
OCR_FALLBACK_PROVIDER=claude
OCR_FALLBACK_MODEL=claude-3-5-haiku-20241022
CARD_GENERATION_PROVIDER=claude
CARD_GENERATION_MODEL=claude-opus-4-6
CARD_TAGGING_PROVIDER=claude
CARD_TAGGING_MODEL=claude-haiku-4-5-20251001
COMPOUND_BREAKDOWN_PROVIDER=claude
COMPOUND_BREAKDOWN_MODEL=claude-haiku-4-5-20251001
TRANSLATION_VERIFY_PROVIDER=claude
TRANSLATION_VERIFY_MODEL=claude-haiku-4-5-20251001

# OCR settings
OCR_CONFIDENCE_THRESHOLD=0.60

# IronOCR sidecar (optional — set IRONOCR_URL to enable the .NET OCR engine)
# IRONOCR_URL=http://ironocr:5050   # set automatically by docker-compose
IRONOCR_LICENSE_KEY=             # your IronOCR license key (leave blank for trial/watermark mode)

# Upload limits
MAX_UPLOAD_SIZE_MB=20

# App
SECRET_KEY=change-me-at-least-32-chars-long
LOG_LEVEL=INFO
